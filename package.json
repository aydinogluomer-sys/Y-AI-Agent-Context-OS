{
  "name": "y-ai-agent-context-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner && vite build --ssr server.ts --configLoader runner --outDir dist/server --emptyOutDir",
    "start": "node dist/server/server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "test": "vitest run",
    "worker:index": "tsx workers/index-worker.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "db:migrate": "tsx apps/api/src/scripts/migrate.ts",
    "db:status": "tsx apps/api/src/scripts/status.ts",
    "db:reset:dev": "tsx scripts/db-reset-dev.ts",
    "qa:debug-tags": "tsx scripts/qa-debug-tags.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "legacy:test:db": "tsx scripts/run-validation-suite.ts db",
    "audit:inventory": "tsx scripts/audit/inventory-api.ts && tsx scripts/audit/inventory-ui.ts && tsx scripts/audit/inventory-db.ts && tsx scripts/audit/generate-reports.ts",
    "audit:verify": "tsx scripts/audit/verify-inventories.ts",
    "audit:false-green": "tsx scripts/audit/scan-false-green.ts",
    "audit:registry": "tsx scripts/audit/rebuild-feature-registry.ts",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "migrations:mapping": "tsx scripts/audit/regenerate-migration-mapping.ts",
    "gate:drift": "tsx scripts/audit/verify-inventories.ts",
    "db:test:up": "docker compose up -d --wait",
    "db:test:down": "docker compose down -v",
    "db:test:reset": "docker compose down -v && docker compose up -d --wait",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify:evidence-chain": "tsx scripts/db/verify-evidence-chain.ts",
    "perf:fixture": "tsx scripts/perf/generate-fixture-repo.ts --preset small --out .perf/small",
    "perf": "tsx scripts/perf/measure.ts --fixture .perf/small",
    "perf:record": "tsx scripts/perf/measure.ts --fixture .perf/small --record",
    "gate:false-green": "tsx scripts/audit/scan-false-green.ts --gate",
    "gate:all": "npm run gate:ci-scripts && npm run gate:route-scope && npm run gate:dotenv-precedence && npm run typecheck && npm run gate:drift && npm run gate:false-green && npm run secret-scan && npx vitest run",
    "gate:mutation": "tsx scripts/mutation/run.ts",
    "gate:ci-scripts": "tsx scripts/audit/verify-ci-scripts.ts",
    "perf:scale": "tsx scripts/perf/measure-scale.ts --fixture .perf/repo-10k",
    "gate:route-scope": "tsx scripts/audit/verify-route-scope.ts",
    "gate:dotenv-precedence": "tsx scripts/audit/verify-dotenv-precedence.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tree-sitter-wasms": "^0.1.13",
    "vite": "^6.2.3",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "node-domexception": "file:./packages/node-domexception"
  }
}
