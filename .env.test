# P19 / T1 — Entegrasyon testi ortami.
#
# Bu dosya GITE GIRER ve girmesi guvenlidir: HICBIR kimlik bilgisi
# icermez. Yerel konteyner trust auth kullanir ve 127.0.0.1'e baglidir.
#
# Uretim sirlari ASLA burada olmaz — secret manager'dan gelir (ADR-073).

# Parola YOK: konteyner trust auth ile ve yalniz 127.0.0.1'e bagli.
# Depoda kimlik bilgisi tutmamak, onu maskelemekten iyidir.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/y_test
NODE_ENV=test

# Worker kimligi imzalama. Testte SABIT bir anahtar kullaniliyor ki
# kosular arasinda uretilen kimlikler karsilastirilabilsin.
# Uretimde bu deger secret manager'dan gelir ve her dagitimda farklidir.
WORKER_SIGNING_KEY=integration-test-signing-key-32-chars-min

# Mock DB ve offline boot KAPALI: entegrasyon testi GERCEK veritabanina
# karsi calisir. Acik birakmak, testin sessizce mock'a dusup "gecti"
# demesine yol acardi (spec §37).
ENABLE_MOCK_DB=false
ALLOW_OFFLINE_API_BOOT=false
