# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Location of the persistent postgres or local mock SQL database for Y-OS Metadata
# Keep safe. Under default security boundary rules, zero passwords will leak in logs.
DATABASE_URL="postgresql://y_user:safe_database_pass@localhost:5432/y_vault"

# ENABLE_MOCK_DB: Explicitly opt-in to the volatile mock in-memory database connector in development mode.
# Strictly forbidden in production environments. Must be "true" to activate.
ENABLE_MOCK_DB=

# ALLOW_OFFLINE_API_BOOT: Development-only escape hatch for the database setup screen.
# Keep false/empty by default. It is ignored in production.
ALLOW_OFFLINE_API_BOOT=

# Y_API_AUTH_TOKEN: Required in production. Use a high-entropy server-side token.
Y_API_AUTH_TOKEN=

# Y_API_AUTH_ACTOR / ROLE / PROJECTS define the configured token principal.
Y_API_AUTH_ACTOR=api-operator
Y_API_AUTH_ROLE=developer
Y_API_AUTH_PROJECTS=

# Standalone index worker connects through the authenticated API.
API_BASE_URL=http://127.0.0.1:3000
INDEX_WORKER_PROJECT_ID=
INDEX_WORKER_ID=index-worker-1
INDEX_WORKER_TOKEN=
INDEX_WORKER_POLL_MS=2000
INDEX_WORKER_RUN_ONCE=false

# SUPABASE_CA_CERT: Raw PEM content of the Supabase CA certificate for secure SSL connections.
SUPABASE_CA_CERT=

# SUPABASE_CA_CERT_BASE64: Base64-encoded string representing the Supabase CA certificate.
SUPABASE_CA_CERT_BASE64=
