# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Location of the persistent postgres or local mock SQL database for Y-OS Metadata
# Keep safe. Under default security boundary rules, zero passwords will leak in logs.
DATABASE_URL="postgresql://y_user:safe_database_pass@localhost:5432/y_vault"

# ENABLE_MOCK_DB: Volatile in-memory mock database connector.
#
# !!! GUVENLIK UYARISI (P00 Truth Audit / P0-1) !!!
# Bu deger "true" oldugunda GET /api/auth/dev-session endpoint'i ACILIR ve
# KIMLIK DOGRULAMASI OLMADAN role:"admin", projectIds:["*"] tasiyan bir bearer
# token dagitir. Porta erisebilen herkes tam yetki alir.
# Ayrica MockDatabaseConnector migration'lari "uygulanmis" sayar; testler
# yanlis yesil verir.
#
# Uretimde ve PAYLASILAN HICBIR ORTAMDA "true" olmamalidir. Yerel gelistirmede
# de tercih edilmez; P02'den itibaren yerine gercek OIDC (docker/idp) gelir.
# P19'da bu bayrak ve mock connector tamamen silinecektir.
ENABLE_MOCK_DB=

# ALLOW_OFFLINE_API_BOOT: DB baglanamadiginda boot'a devam etme kacamagi.
#
# UYARI (P00 Truth Audit / P1-4): Bu bayrak, veritabani baslatilamadiginda
# uygulamanin sessizce ayakta kalmasina yol açar; bozukluk calisma zamaninda
# ve dagitik bicimde ortaya cikar. P19'da silinecektir.
ALLOW_OFFLINE_API_BOOT=

# Y_API_AUTH_TOKEN: Required in production. Use a high-entropy server-side token.
Y_API_AUTH_TOKEN=

# Remote OIDC / Keycloak / Auth0 JWKS endpoint for dynamic RS256 JWT public key resolution
JWKS_URI=
OIDC_JWKS_URI=

# Y_API_AUTH_ACTOR / ROLE / PROJECTS define the configured token principal.
Y_API_AUTH_ACTOR=api-operator
Y_API_AUTH_ROLE=developer
Y_API_AUTH_PROJECTS=

# Standalone index worker connects through the authenticated API.
API_BASE_URL=http://127.0.0.1:3000
INDEX_WORKER_PROJECT_ID=
INDEX_WORKER_ID=index-worker-1
INDEX_WORKER_TOKEN=
INDEX_WORKER_POLL_MS=2000
INDEX_WORKER_RUN_ONCE=false

# SUPABASE_CA_CERT: Raw PEM content of the Supabase CA certificate for secure SSL connections.
SUPABASE_CA_CERT=

# SUPABASE_CA_CERT_BASE64: Base64-encoded string representing the Supabase CA certificate.
SUPABASE_CA_CERT_BASE64=

# --- P00 Truth Audit: kod tarafindan okunan ama daha once burada
#     belgelenmemis degiskenler ---

# JWT dogrulamasi (apps/api/src/auth.ts).
# UYARI (P0-3): JWT_SECRET bos birakilirsa HS256 imzalama anahtari olarak
# Y_API_AUTH_TOKEN kullanilir; yani paylasimli API token'i olan biri
# role:"admin" iceren JWT uretebilir. P02'de jose + JWKS'e gecilecek.
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_RS256_PUBLIC_KEY=
EXPECTED_JWT_ISSUER=
EXPECTED_JWT_AUDIENCE=

# UYARI (P0-5): Asagidaki bayraklarin herhangi biri set edildiginde
# PermissionKernelService DB hatasinda STATIK ALLOW listesine duser
# (fail-open). CI=true bile bu etkiyi yapar. P02'de bu yol silinecektir.
ALLOW_STATIC_POLICY_FALLBACK=
DETERMINISTIC_TEST_MODE=

# Demo seed ve arama sunucusu turu
ENABLE_DEMO_SEED=
SEARCH_SERVER_KIND=local_sql

# Sunucu
HOST=127.0.0.1
PORT=3000
SERVE_STATIC=
SUPABASE_DIRECT_DATABASE_URL=
